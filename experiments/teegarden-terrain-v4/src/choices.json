  "steps": [
    {
      "id": "location",
      "label": "어디에 기지를 세울까?",
      "choices": [
        { "id": "A", "label": "현무암 평원", "line": "넓고 밝지만, 늘 뜨거운 곳", "site": "plain" },
        { "id": "B", "label": "용암동굴", "line": "바위 지붕 아래 숨는 곳", "site": "lavaTube" },
        { "id": "C", "label": "황혼 능선", "line": "빛도 받고 그늘도 있는 비탈길", "site": "ridge" }
      ]
    },
    {
      "id": "module",
      "label": "기지를 어떻게 지을까?",
      "choices": [
        { "id": "A1", "label": "텐트처럼 빨리 펼치기", "line": "오늘 바로 들어가 살 수 있어요", "requires": { "location": ["A"] }, "module": "tent_deploy" },
        { "id": "A2", "label": "흙 이불 덮기", "line": "시간은 걸려도 시원하게", "requires": { "location": ["A"] }, "module": "soil_cover" },
        { "id": "B1", "label": "입구 앞 마을", "line": "드나들기 쉬운 굴 입구", "requires": { "location": ["B"] }, "module": "cave_entrance" },
        { "id": "B2", "label": "깊은 굴속 마을", "line": "가장 안전하지만 가장 먼 곳", "requires": { "location": ["B"] }, "module": "cave_deep" },
        { "id": "C1", "label": "계단식 한 동네", "line": "모여 살면 편해요", "requires": { "location": ["C"] }, "module": "terrace" },
        { "id": "C2", "label": "흩어진 마을", "line": "나눠 살면 덜 위험해요", "requires": { "location": ["C"] }, "module": "scattered" }
      ]
