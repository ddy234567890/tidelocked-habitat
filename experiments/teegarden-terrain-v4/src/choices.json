        { "id": "O2", "label": "숨 재활용 기계", "line": "내쉰 숨으로 물을 되찾아요", "overlays": ["recycler"] },
        { "id": "O3", "label": "작은 산소 기계 여러 대", "line": "하나가 고장 나도 괜찮아요", "overlays": ["small_units"] }
      ]
