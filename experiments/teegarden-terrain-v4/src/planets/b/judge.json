    { "requires": { "oxygen": ["O2"] }, "demandAdd": { "water": 1 } },
    { "requires": { "pool": ["X1"] }, "lowest": 3 }
  ],
  "tests": [
    {
      "name": "주 전원 정지",
      "damage": { "power": 34, "air": 24 },
      "adjust": [
        { "requires": { "storage": ["S2"] }, "add": { "power": -6, "air": -4 } },
        { "requires": { "power": ["P2"] }, "add": { "power": 6 } },
        { "requires": { "pool": ["X2"] }, "add": { "power": -6, "air": -4 } },
        { "requires": { "pool": ["X1"] }, "add": { "power": 4, "air": 4 } },
        { "requires": { "oxygen": ["O3"] }, "add": { "air": -7 } },
        { "requires": { "heat": ["T2"] }, "add": { "air": 4 } }
      ]
    },
    {
      "name": "주 정수 설비 고장",
      "damage": { "water": 33, "food": 0 },
      "adjust": [
        { "requires": { "share": ["D2"] }, "add": { "water": -7 } },
        { "requires": { "oxygen": ["O2"] }, "add": { "water": -4 } },
        { "requires": { "pool": ["X2"] }, "add": { "water": -3 } },
        { "requires": { "crop": ["C_leaf", "C_staple", "C_algae"] }, "add": { "food": 4 } }
      ]
    }
  ],
  "reinforce": { "requires": { "fix": ["U2"] }, "ease": 12 },
  "strategies": [
    { "any": [{ "oxygen": ["O2"] }, { "reuse": ["R2"] }], "text": "물을 되살려 쓰는 회수 설비" },
    { "any": [{ "module": ["C2"] }, { "oxygen": ["O3"] }, { "storage": ["S2"] }, { "share": ["D2"] }, { "pool": ["X2"] }], "text": "구역을 나눠 피해를 막는 분산 설계" },
    { "any": [{ "power": ["P2"] }], "text": "일정한 원자로 전력" }
